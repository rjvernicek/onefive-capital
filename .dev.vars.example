# Copy to .dev.vars for `wrangler dev`. Never commit the real file.
# In production these are set with `wrangler secret put <NAME>` instead.

ANTHROPIC_API_KEY=sk-ant-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# The Healthspan MCP server endpoint and its bearer token.
# Omit HEALTHSPAN_MCP_TOKEN if the server needs no auth.
HEALTHSPAN_MCP_URL=https://...
HEALTHSPAN_MCP_TOKEN=...

# Copy to .dev.vars for `wrangler dev`. Never commit the real file.
# In production these are set with `wrangler secret put <NAME>` instead.

ANTHROPIC_API_KEY=sk-ant-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# The Healthspan MCP endpoint.
#
# Treat the whole URL as a credential. Some deployments carry the auth token as
# a path segment (…/mcp/<long-hex-string>), in which case the URL alone grants
# full read/write access to the record and HEALTHSPAN_MCP_TOKEN is left unset.
# Only set the token when the server authenticates with a separate bearer.
HEALTHSPAN_MCP_URL=https://...
# HEALTHSPAN_MCP_TOKEN=...

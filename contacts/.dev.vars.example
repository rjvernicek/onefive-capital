# Copy to .dev.vars for `wrangler dev`. Never commit the real file.
# In production these are set with `wrangler secret put <NAME>` instead.

ANTHROPIC_API_KEY=sk-ant-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Azure app registration for Microsoft Graph (Outlook contacts).
MS_CLIENT_ID=...
MS_CLIENT_SECRET=...

# Long random string guarding /auth/start and /sync. Generate with:
#   openssl rand -hex 32
ADMIN_KEY=...
